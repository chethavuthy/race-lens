# Copy to .env.deploy (gitignored) and fill in. Nothing here is ever printed,
# committed, or echoed — the deploy script reads it and passes values straight
# to wrangler/gh as stdin or env.
#
#   cp .env.deploy.example .env.deploy
#   $EDITOR .env.deploy
#   ./tools/deploy.sh

# --- Cloudflare -------------------------------------------------------------
# Create at: https://dash.cloudflare.com/profile/api-tokens → Create Token →
# Custom token. `wrangler login` does NOT cover these — its OAuth grant has
# zone:read but no DNS or Access write, so the last mile cannot be automated
# without a real token.
#   Zone    · DNS                       · Edit   (zone: runlytics.fit)
#   Zone    · Zone                      · Read   (zone: runlytics.fit)
#   Account · Access: Apps and Policies · Edit
#   Account · Cloudflare Pages          · Read
# Then run ./tools/finish-deploy.sh
CLOUDFLARE_API_TOKEN=
# Dashboard → any domain → right sidebar "Account ID"
CLOUDFLARE_ACCOUNT_ID=

# --- Google Drive -----------------------------------------------------------
# console.cloud.google.com → enable "Google Drive API" → Credentials → API key.
# Restrict it to the Drive API. No OAuth, no service account.
GOOGLE_API_KEY=

# --- GitHub -----------------------------------------------------------------
# github.com/settings/tokens?type=beta — fine-grained, this repo only:
#   Contents: Read and write   (repository_dispatch)
#   Secrets:  Read and write   (so the script can set Actions secrets)
#   Actions:  Read and write
GH_TOKEN=
# owner/name — the repo will be created if it does not exist.
GH_REPO=

# --- Access -----------------------------------------------------------------
# The email allowed into /admin.
ADMIN_EMAIL=vuthychetha@gmail.com

# --- Optional ---------------------------------------------------------------
# Leave blank to let the script generate a strong one and set it on both sides.
INGEST_SECRET=
# R2 S3-API credentials for the CI runner. Leave blank and the script prints
# the exact dashboard path — R2 tokens cannot be minted via the Workers API.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
