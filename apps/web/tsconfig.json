{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
  // The .vue pages are still here as the reference for the port, but they are no
  // longer compiled: nothing imports them and vue-tsc is gone from the scripts.
  // They come out as each one is ported.
  "exclude": ["src/pages/**/*.vue", "src/components/**/*.vue", "src/App.vue", "src/main.ts"]
}
